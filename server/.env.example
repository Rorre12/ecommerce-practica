# Conexión a PostgreSQL
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/ecommerce?schema=public"

# Servidor HTTP
PORT=4000
CORS_ORIGIN=http://localhost:5173

# JWT (cambia el secreto en producción)
JWT_SECRET=cambia-este-secreto-por-uno-largo-y-aleatorio
JWT_EXPIRES_IN=8h

# Usuario administrador creado por el seed
ADMIN_EMAIL=admin@tienda.com
ADMIN_PASSWORD=Admin123!

# Correo (Nodemailer). Sin SMTP_HOST se crea una cuenta de pruebas de Ethereal automáticamente.
# Mailtrap: SMTP_HOST=sandbox.smtp.mailtrap.io SMTP_PORT=2525 y el usuario/contraseña del inbox.
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
MAIL_FROM='"Materiales El Constructor" <pedidos@elconstructor.test>'
ADMIN_NOTIFY_EMAIL=admin@tienda.com

# Datos bancarios que se envían en las instrucciones de pago
PAYMENT_BANK=BBVA México
PAYMENT_ACCOUNT_HOLDER=Materiales El Constructor S.A. de C.V.
PAYMENT_ACCOUNT_NUMBER=0123456789
PAYMENT_CLABE=012100001234567891
PAYMENT_DEADLINE_HOURS=48
